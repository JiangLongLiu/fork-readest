# ============================================================
# Readest Self-Hosted Deployment - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# IMPORTANT: After editing, start services with:
#   docker compose up -d

# -----------------------------------------------------------
# Server IP (REQUIRED)
# -----------------------------------------------------------
# The IP address or domain that clients use to reach your server.
# Examples: public IP, LAN IP, Tailscale IP, or domain name.
HOST_IP=<YOUR_SERVER_IP>
READEST_IMAGE=ghcr.io/readest/readest:latest

# -----------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------
# Password must be at least 32 characters long.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD_MIN_32_CHARS>
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# -----------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------
# JWT token expiry in seconds (default: 3600 = 1 hour).
# Increase if clients experience frequent logouts.
JWT_EXPIRY=3600

# Secret key for signing JWTs. Must be at least 64 characters.
# Generate one with: openssl rand -hex 48
JWT_SECRET=<YOUR_JWT_SECRET_MIN_64_CHARS>

# These keys MUST be generated using YOUR JWT_SECRET above.
# Method 1 - Node.js:
#   node -e "const jwt=require('jsonwebtoken'); const s='YOUR_SECRET'; \
#     console.log('ANON_KEY:', jwt.sign({role:'anon'}, s, {expiresIn:'10y'})); \
#     console.log('SERVICE_ROLE_KEY:', jwt.sign({role:'service_role'}, s, {expiresIn:'10y'}));"
#
# Method 2 - Online at https://jwt.io
#   Header: {"alg":"HS256","typ":"JWT"}
#   Payload for ANON_KEY: {"role":"anon"}
#   Payload for SERVICE_ROLE_KEY: {"role":"service_role"}
#   Secret: your JWT_SECRET value
ANON_KEY=<GENERATE_WITH_YOUR_JWT_SECRET>
SERVICE_ROLE_KEY=<GENERATE_WITH_YOUR_JWT_SECRET>

# -----------------------------------------------------------
# Kong API Gateway
# -----------------------------------------------------------
KONG_HTTP_PORT=8000

# -----------------------------------------------------------
# Auth (GoTrue) - External URLs
# -----------------------------------------------------------
# These MUST use the same HOST_IP that clients connect to.
API_EXTERNAL_URL=http://<YOUR_SERVER_IP>:8000
SITE_URL=http://<YOUR_SERVER_IP>:3000

# Callback URLs for OAuth and mobile deep links.
# IMPORTANT: Must include "readest://auth-callback" for Android/iOS login to work.
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,http://localhost:8000/**,http://<YOUR_SERVER_IP>:3000/**,http://<YOUR_SERVER_IP>:8000/**,readest://auth-callback

# -----------------------------------------------------------
# Registration Settings
# -----------------------------------------------------------
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Set to false if you want email verification (requires SMTP below)
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

# -----------------------------------------------------------
# SMTP (only needed when ENABLE_EMAIL_AUTOCONFIRM=false)
# -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Readest

# -----------------------------------------------------------
# PostgREST
# -----------------------------------------------------------
PGRST_DB_SCHEMAS=public,graphql_public

# -----------------------------------------------------------
# MinIO Object Storage (S3-compatible)
# -----------------------------------------------------------
OBJECT_STORAGE_TYPE=s3
MINIO_ROOT_USER=minioadmin
# Change this! Generate with: openssl rand -hex 16
MINIO_ROOT_PASSWORD=<YOUR_MINIO_PASSWORD>
S3_BUCKET_NAME=readest-files

# -----------------------------------------------------------
# Quotas
# -----------------------------------------------------------
# Storage quota per user in bytes.
#   1GB  = 1073741824
#   5GB  = 5368709120
#  10GB  = 10737418240
#  20GB  = 21474836480
#  50GB  = 53687091200
# 100GB  = 107374182400
STORAGE_FIXED_QUOTA=21474836480
TRANSLATION_FIXED_QUOTA=50000
