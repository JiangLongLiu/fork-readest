# ============================================================
# Readest Self-Hosted - Tauri Client Build Configuration
# ============================================================
# This file is used at BUILD TIME for Android and Windows clients.
# Copy to apps/readest-app/.env.tauri and replace all <PLACEHOLDER> values.
#
# Usage:
#   cp .env.tauri.example apps/readest-app/.env.tauri
#   # edit with your actual server values
#   npx tauri build          # Windows
#   npx tauri android build  # Android

NEXT_PUBLIC_APP_PLATFORM=tauri

DBUS_ID=com.bilingify.readest

# -----------------------------------------------------------
# Self-Hosted Server (REQUIRED)
# -----------------------------------------------------------
# The URL your clients use to reach the Kong gateway.
# Format: http://<YOUR_SERVER_IP>:<PORT>
NEXT_PUBLIC_SUPABASE_URL=http://<YOUR_SERVER_IP>:8000

# JWT Anon Key - generate from your JWT_SECRET:
#   node -e "console.log(require('jsonwebtoken').sign({role:'anon'},'YOUR_SECRET',{expiresIn:'10y'}))"
NEXT_PUBLIC_SUPABASE_ANON_KEY=<GENERATE_FROM_YOUR_JWT_SECRET>

# JWT Service Role Key - for server-side builds only, KEEP SECRET!
SUPABASE_ADMIN_KEY=<GENERATE_FROM_YOUR_JWT_SECRET>

# -----------------------------------------------------------
# API & Web URLs
# -----------------------------------------------------------
# Internal API (PostgREST direct, optional)
NEXT_PUBLIC_API_BASE_URL=http://<YOUR_SERVER_IP>:3000

# Web frontend base URL (Kong gateway, used for share links)
NEXT_PUBLIC_WEB_BASE_URL=http://<YOUR_SERVER_IP>:8000

# -----------------------------------------------------------
# Quotas
# -----------------------------------------------------------
# Storage per user (bytes): 20GB = 21474836480
NEXT_PUBLIC_STORAGE_FIXED_QUOTA=21474836480
# Translation character quota: 50000
NEXT_PUBLIC_TRANSLATION_FIXED_QUOTA=50000

# -----------------------------------------------------------
# S3 Object Storage (MinIO)
# -----------------------------------------------------------
NEXT_PUBLIC_OBJECT_STORAGE_TYPE=s3
S3_ENDPOINT=http://<YOUR_SERVER_IP>:9000
S3_ACCESS_KEY_ID=<YOUR_MINIO_ROOT_USER>
S3_SECRET_ACCESS_KEY=<YOUR_MINIO_ROOT_PASSWORD>
S3_BUCKET_NAME=readest-files
S3_REGION=us-east-1
