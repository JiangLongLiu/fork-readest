# ============================================================
# Readest Self-Hosted - Environment Configuration (Sanitized)
# ============================================================
# This is a sanitized example file for reference.
# Copy to docker/.env and replace all <PLACEHOLDER> values.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your actual values
#   docker compose up -d

# -----------------------------------------------------------
# Server IP (REQUIRED)
# -----------------------------------------------------------
# The IP or domain clients use to reach your server.
# Examples: 203.0.113.10, 192.168.1.100, readest.example.com
HOST_IP=<YOUR_SERVER_IP>
READEST_IMAGE=ghcr.io/readest/readest:latest

# -----------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------
# MUST be at least 32 characters. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD_MIN_32_CHARS>
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# -----------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------
# Token expiry in seconds (default 3600 = 1 hour)
JWT_EXPIRY=3600

# MUST be at least 64 characters. Generate with: openssl rand -hex 48
JWT_SECRET=<YOUR_JWT_SECRET_MIN_64_CHARS>

# IMPORTANT: Generate these from YOUR JWT_SECRET:
#   node -e "const j=require('jsonwebtoken');const s='YOUR_SECRET'; \
#     console.log('ANON_KEY:',j.sign({role:'anon'},s,{expiresIn:'10y'})); \
#     console.log('SERVICE_ROLE_KEY:',j.sign({role:'service_role'},s,{expiresIn:'10y'}));"
#
# Or use https://jwt.io with:
#   Payload for ANON_KEY:          {"role":"anon"}
#   Payload for SERVICE_ROLE_KEY:  {"role":"service_role"}
ANON_KEY=<GENERATE_FROM_YOUR_JWT_SECRET>
SERVICE_ROLE_KEY=<GENERATE_FROM_YOUR_JWT_SECRET>

# -----------------------------------------------------------
# Kong API Gateway
# -----------------------------------------------------------
KONG_HTTP_PORT=8000

# -----------------------------------------------------------
# Auth (GoTrue) - External URLs
# -----------------------------------------------------------
# MUST match the HOST_IP your clients connect to.
API_EXTERNAL_URL=http://<YOUR_SERVER_IP>:8000
SITE_URL=http://<YOUR_SERVER_IP>:3000

# Callback URLs. MUST include readest://auth-callback for mobile login.
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**,http://localhost:8000/**,http://<YOUR_SERVER_IP>:3000/**,http://<YOUR_SERVER_IP>:8000/**,readest://auth-callback

# -----------------------------------------------------------
# Registration Settings
# -----------------------------------------------------------
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false

# -----------------------------------------------------------
# SMTP (only needed when ENABLE_EMAIL_AUTOCONFIRM=false)
# -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=Readest

# -----------------------------------------------------------
# PostgREST
# -----------------------------------------------------------
PGRST_DB_SCHEMAS=public,graphql_public

# -----------------------------------------------------------
# MinIO Object Storage (S3-compatible)
# -----------------------------------------------------------
OBJECT_STORAGE_TYPE=s3
MINIO_ROOT_USER=minioadmin
# Change this! Generate with: openssl rand -hex 16
MINIO_ROOT_PASSWORD=<YOUR_MINIO_PASSWORD>
S3_BUCKET_NAME=readest-files

# -----------------------------------------------------------
# Quotas
# -----------------------------------------------------------
# Storage per user (bytes): 1GB=1073741824, 10GB=10737418240, 20GB=21474836480
STORAGE_FIXED_QUOTA=21474836480
TRANSLATION_FIXED_QUOTA=50000
